-- [ СЕКЦИЯ 10: ФУНКЦИИ AUTO FARM ]
-- ============================================================

local function StartAutoFarm()
    task.spawn(function()
        while Config.AutoFarm do
            local char = LocalPlayer.Character
            local hrp = GetRootPart()
            
            if char and hrp then
                local coin, dist = GetNearestCoin()
                if coin then
                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        humanoid.WalkSpeed = Config.AutoFarmSpeed
                        humanoid:MoveTo(coin.Position)
                    end
                end
            end
            
            task.wait(0.3)
        end
    end)
end

local function CollectAllCoins()
    local hrp = GetRootPart()
    if not hrp then return end
    
    local coins = GetAllCoins()
    local count = 0
    
    for _, coin in pairs(coins) do
        if coin and coin.Parent then
            hrp.CFrame = coin.CFrame + Vector3.new(0, 3, 0)
            count = count + 1
            task.wait(0.05)
        end
    end
    
    Notify("Farm", "Собрано " .. count .. " монет ♡", 3, "success")
end

local function AutoRespawnLoop()
    task.spawn(function()
        while Config.AutoRespawn do
            local humanoid = GetHumanoid()
            if humanoid and humanoid.Health <= 0 then
                task.wait(2)
                pcall(function()
                    LocalPlayer:LoadCharacter()
                end)
            end
            task.wait(1)
        end
    end)
end

local function AvoidMurdererLoop()
    task.spawn(function()
        while Config.AvoidMurderer do
            local hrp = GetRootPart()
            local murderer = GetMurderer()
            
            if hrp and murderer and murderer.Character then
                local mHrp = murderer.Character:FindFirstChild("HumanoidRootPart")
                if mHrp then
                    local dist = (mHrp.Position - hrp.Position).Magnitude
                    if dist < 40 then
                        local fleeDir = (hrp.Position - mHrp.Position).Unit
                        local humanoid = GetHumanoid()
                        if humanoid then
                            humanoid:MoveTo(hrp.Position + fleeDir * 50)
                        end
                    end
                end
            end
            task.wait(0.3)
        end
    end)
end

