                if not espCache[player] then
                    CreateESP(player, roleColor)
                end
                
                if espCache[player] then
                    local mainLabel = espCache[player]:FindFirstChild("MainLabel")
                    local infoLabel = espCache[player]:FindFirstChild("InfoLabel")
                    local myHrp = GetRootPart()
                    
                    if mainLabel then
