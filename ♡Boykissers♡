    local dot = Create("Frame", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = default and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Parent = toggleBtn
    })
    Corner(dot, 8)
    
    local state = default
    local function updateToggle()
        Tween(toggleBtn, 0.2, {BackgroundColor3 = state and Theme.ToggleOn or Theme.ToggleOff})
        Tween(dot, 0.2, {Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)})
    end
    updateToggle()
    
    toggleBtn.MouseButton1Click:Connect(function()
        state = not state
        updateToggle()
        if callback then callback(state) end
    end)
    
    -- Шестерёнка настроек (если переданы options)
    if settingsOptions and #settingsOptions > 0 then
        local gearBtn = Create("TextButton", {
            Size = UDim2.new(0, 22, 0, 22),
