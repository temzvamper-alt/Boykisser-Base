local function CreateToggle(page, name, defaultValue, callback)
    local row = CreateInstance("Frame", {
        Name = "Toggle_" .. name,
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundTransparency = 1,
        Parent = page,
    })
    
