-- FLY (рабочий)
local flyBV, flyBG
local function EnableFly()
    local hrp = GetHRP() if not hrp then return end
    flyBV = Instance.new("BodyVelocity", hrp)
    flyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    flyBV.Velocity = Vector3.zero
    flyBG = Instance.new("BodyGyro", hrp)
    flyBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    flyBG.P = 1000 flyBG.D = 50
    task.spawn(function()
        while Config.Fly do
            local c = GetChar()
            local hum = c and c:FindFirstChildOfClass("Humanoid")
            local dir = hum and hum.MoveDirection or Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0,1,0) end
            if flyBV then flyBV.Velocity = dir * Config.FlySpeed end
            if flyBG then flyBG.CFrame = Cam.CFrame end
            task.wait()
        end
        if flyBV then flyBV:Destroy() flyBV = nil end
        if flyBG then flyBG:Destroy() flyBG = nil end
    end)
end
local function DisableFly()
    Config.Fly = false
    if flyBV then flyBV:Destroy() flyBV = nil end
    if flyBG then flyBG:Destroy() flyBG = nil end
end

-- INVISIBLE (рабочий)
local invisSaved = {}
local function EnableInvisible()
    local c = GetChar() if not c then return end
    invisSaved = {}
    for _, p in pairs(c:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            invisSaved[p] = p.Transparency p.Transparency = 1
        elseif p:IsA("Decal") then
            invisSaved[p] = p.Transparency p.Transparency = 1
        end
    end
end
local function DisableInvisible()
    for p, t in pairs(invisSaved) do
        if p and p.Parent then p.Transparency = t end
    end
    invisSaved = {}
end

-- AUTO FARM
local function StartAutoFarm()
    task.spawn(function()
        while Config.AutoFarm do
            local c = GetChar() local hrp = GetHRP()
            if c and hrp then
                local cl, d = nil, math.huge
                for _, o in pairs(workspace:GetDescendants()) do
                    if o.Name == "Coin" or o.Name == "Money" then
                        local pt = o:IsA("BasePart") and o or o:FindFirstChild("Handle")
                        if pt then
                            local dd = (pt.Position - hrp.Position).Magnitude
                            if dd < d and dd < 500 then d, cl = dd, pt end
                        end
                    end
                end
                if cl then
                    local h = c:FindFirstChildOfClass("Humanoid")
                    if h then h.WalkSpeed = Config.AutoFarmSpeed h:MoveTo(cl.Position) end
                end
            end
            task.wait(0.3)
        end
    end)
end

-- KILL AURA
local function StartKillAura()
    task.spawn(function()
        while Config.KillAura do
            local c = GetChar() local hrp = GetHRP()
            if c and hrp then
                local tool = c:FindFirstChildOfClass("Tool")
                if tool then
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LP and p.Character then
                            local t = p.Character:FindFirstChild("HumanoidRootPart")
                            if t and (t.Position - hrp.Position).Magnitude <= Config.KillAuraRange then
                                tool:Activate()
                            end
                        end
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end

