-- Функции для работы с персонажем, ролями, игроками.

local function GetCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function GetHumanoid()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function GetRootPart()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function GetHead()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("Head")
end

local function GetMurderer()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            if char:FindFirstChild("Knife") 
               or char:FindFirstChild("KillEffect") 
               or char:FindFirstChild("MURDERER") then
                return player
            end
        end
    end
    return nil
end

local function GetSheriff()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            if char:FindFirstChild("Gun") 
               or char:FindFirstChild("Revolver")
               or char:FindFirstChild("SHERIFF") then
                return player
            end
        end
    end
    return nil
end

local function GetMyRole()
    local char = LocalPlayer.Character
    if not char then return "Unknown" end
    if char:FindFirstChild("Knife") or char:FindFirstChild("KillEffect") then
        return "Murderer"
    end
    if char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") then
        return "Sheriff"
    end
    return "Innocent"
end

local function GetNearestCoin()
    local hrp = GetRootPart()
    if not hrp then return nil end
    
    local closest = nil
    local shortestDist = math.huge
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name == "Coin" or obj.Name == "Money" or 
           (obj:IsA("Model") and obj.Name:lower():find("coin")) then
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChild("Handle")
            if part and part.Parent then
                local dist = (part.Position - hrp.Position).Magnitude
                if dist < shortestDist and dist < 500 then
                    shortestDist = dist
                    closest = part
                end
            end
        end
    end
    
    return closest, shortestDist
end

local function GetAllCoins()
    local coins = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name == "Coin" or obj.Name == "Money" or
           (obj:IsA("Model") and obj.Name:lower():find("coin")) then
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChild("Handle")
            if part and part.Parent then
                table.insert(coins, part)
            end
        end
    end
    return coins
end

local function TeleportToPosition(position)
    local hrp = GetRootPart()
    if hrp then
        hrp.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
    end
end

local function TeleportToPlayer(player, offset)
    if not player or not player.Character then return end
    local hrp = GetRootPart()
    local targetHrp = player.Character:FindFirstChild("HumanoidRootPart")
    if hrp and targetHrp then
        local off = offset or CFrame.new(0, 0, -3)
        hrp.CFrame = targetHrp.CFrame * off
    end
end

