        Text = name,
        TextColor3 = Colors.TextMain,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })
    
    local toggleButton = CreateInstance("TextButton", {
        Name = "Toggle",
        Size = UDim2.new(0, 40, 0, 20),
        Position = UDim2.new(1, -44, 0.5, -10),
        BackgroundColor3 = defaultValue and Colors.ToggleOn or Colors.ToggleOff,
        Text = "",
        AutoButtonColor = false,
        Parent = row,
    })
    AddCorner(toggleButton, 10)
    AddStroke(toggleButton, Colors.Outline, 1)
    
    local dot = CreateInstance("Frame", {
        Name = "Dot",
        Size = UDim2.new(0, 14, 0, 14),
        Position = defaultValue 
            and UDim2.new(1, -16, 0.5, -7) 
            or UDim2.new(0, 2, 0.5, -7),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Parent = toggleButton,
    })
    AddCorner(dot, 7)
    
    local state = defaultValue
    
    toggleButton.MouseButton1Click:Connect(function()
        state = not state
        Tween(toggleButton, 0.15, {
            BackgroundColor3 = state and Colors.ToggleOn or Colors.ToggleOff,
        })
        Tween(dot, 0.15, {
            Position = state 
                and UDim2.new(1, -16, 0.5, -7) 
                or UDim2.new(0, 2, 0.5, -7),
        })
        if callback then callback(state) end
    end)
    
    return {
        Frame = row,
        Set = function(value)
            state = value
            Tween(toggleButton, 0.15, {
                BackgroundColor3 = value and Colors.ToggleOn or Colors.ToggleOff,
            })
            Tween(dot, 0.15, {
                Position = value 
                    and UDim2.new(1, -16, 0.5, -7) 
                    or UDim2.new(0, 2, 0.5, -7),
            })
        end,
    }
end

local function CreateSlider(page, name, min, max, defaultValue, suffix, callback)
    local holder = CreateInstance("Frame", {
        Name = "Slider_" .. name,
        Size = UDim2.new(1, 0, 0, 52),
        BackgroundTransparency = 1,
        Parent = page,
    })
    
    CreateInstance("TextLabel", {
        Name = "Label",
        Size = UDim2.new(1, -60, 0, 18),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = Colors.TextMain,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = holder,
    })
    
    local valueLabel = CreateInstance("TextLabel", {
        Name = "Value",
        Size = UDim2.new(0, 60, 0, 18),
        Position = UDim2.new(1, -60, 0, 0),
        BackgroundTransparency = 1,
        Text = tostring(defaultValue) .. (suffix or ""),
        TextColor3 = Colors.PinkMain,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = holder,
    })
    
    local sliderBg = CreateInstance("Frame", {
        Name = "Bg",
        Size = UDim2.new(1, 0, 0, 6),
        Position = UDim2.new(0, 0, 0, 30),
        BackgroundColor3 = Colors.ToggleOff,
        BorderSizePixel = 0,
        Parent = holder,
    })
    AddCorner(sliderBg, 3)
    AddStroke(sliderBg, Colors.Outline, 1)
    
    local sliderFill = CreateInstance("Frame", {
        Name = "Fill",
        Size = UDim2.new((defaultValue - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Colors.PinkMain,
        BorderSizePixel = 0,
        Parent = sliderBg,
    })
    AddCorner(sliderFill, 3)
    
    local dragging = false
    
    local function updateFromInput(input)
        local percent = math.clamp(
            (input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X,
            0, 1
        )
        local value = math.floor(min + (max - min) * percent)
        sliderFill.Size = UDim2.new(percent, 0, 1, 0)
        valueLabel.Text = tostring(value) .. (suffix or "")
        if callback then callback(value) end
    end
    
    sliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromInput(input)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement 
           or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromInput(input)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    return holder
end

