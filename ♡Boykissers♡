-- [ СЕКЦИЯ 36: ОБНОВЛЕНИЕ STATS ]
-- ============================================================

local sessionStart = tick()

task.spawn(function()
    while task.wait(2) do
        if statsLabels then
            if statsLabels.Session then
                statsLabels.Session.Text = tostring(math.floor(tick() - sessionStart)) .. "s"
            end
            if statsLabels.Coins then
                statsLabels.Coins.Text = "0"
            end
            if statsLabels.Total then
                statsLabels.Total.Text = "0"
            end
            if statsLabels.Status then
                if Config.AutoFarm then
                    statsLabels.Status.Text = "Farming"
                    statsLabels.Status.TextColor3 = Colors.Success
                else
                    statsLabels.Status.Text = "Waiting"
                    statsLabels.Status.TextColor3 = Colors.TextMain
                end
            end
        end
    end
end)

