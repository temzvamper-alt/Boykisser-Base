local function New(cls, props)
    local o = Instance.new(cls)
    for k, v in pairs(props) do
        if k ~= "Parent" then o[k] = v end
    end
    if props.Parent then o.Parent = props.Parent end
    return o
end
local function Corner(p, r) return New("UICorner", {CornerRadius = UDim.new(0, r or 8), Parent = p}) end
local function Stroke(p, c, t) return New("UIStroke", {Color = c or C.Outline, Thickness = t or 1, Parent = p}) end
local function Tw(o, t, p) local tw = Tween:Create(o, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad), p) tw:Play() return tw end

