-- Работает если исполнитель поддерживает writefile/readfile.

local ConfigFolder = "BoykisserHub"
local ConfigFile = ConfigFolder .. "/config.json"

local function SaveConfig()
    if not ExecFeatures.HasWritefile then
        Notify("Config", "Твой исполнитель не поддерживает сохранение", 3, "error")
        return
    end
    
    local success, err = pcall(function()
        if ExecFeatures.HasMakefolder and not isfolder(ConfigFolder) then
            makefolder(ConfigFolder)
        end
        writefile(ConfigFile, HttpService:JSONEncode(Config))
    end)
    
    if success then
        Notify("Config", "Настройки сохранены ♡", 3, "success")
    else
        Notify("Config", "Ошибка: " .. tostring(err), 4, "error")
    end
end

local function LoadConfig()
    if not ExecFeatures.HasReadfile then
        Notify("Config", "Твой исполнитель не поддерживает загрузку", 3, "error")
        return
    end
    
    local success, data = pcall(function()
        if ExecFeatures.HasIsfile and isfile(ConfigFile) then
            return HttpService:JSONDecode(readfile(ConfigFile))
        end
        return nil
    end)
    
    if success and data then
        for key, value in pairs(data) do
            if Config[key] ~= nil then
                Config[key] = value
            end
        end
        Notify("Config", "Настройки загружены ♡", 3, "success")
    else
        Notify("Config", "Конфиг не найден", 3, "warning")
    end
end

