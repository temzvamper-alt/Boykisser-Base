-- ФУНКЦИИ: AUTO FARM
-- ============================================================
local function StartAutoFarm()
    task.spawn(function()
        while Config.AutoFarm do
            local char = GetChar()
            local hrp = GetHRP()
            if char and hrp then
                local closest, dist = nil, math.huge
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj.Name == "Coin" or obj.Name == "Money" then
                        local part = obj:IsA("BasePart") and obj or obj:FindFirstChild("Handle")
                        if part then
                            local d = (part.Position - hrp.Position).Magnitude
                            if d < dist and d < 500 then dist, closest = d, part end
                        end
                    end
                end
                if closest then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum.WalkSpeed = Config.AutoFarmSpeed
                        hum:MoveTo(closest.Position)
                    end
                end
            end
            task.wait(0.3)
        end
    end)
end

