-- ESP
local espCache = {}
local function UpdateESP()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local c = p.Character
            local isM = c:FindFirstChild("Knife") or c:FindFirstChild("KillEffect")
            local isS = c:FindFirstChild("Gun") or c:FindFirstChild("Revolver")
            local col = isM and Color3.fromRGB(255,105,180) or isS and Color3.fromRGB(180,105,255) or Color3.fromRGB(255,200,230)
            if not espCache[p] then
                local hrp = c:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local bb = Instance.new("BillboardGui", hrp)
                    bb.Size = UDim2.new(0,200,0,50) bb.AlwaysOnTop = true bb.StudsOffset = Vector3.new(0,3,0)
                    local lbl = Instance.new("TextLabel", bb)
                    lbl.Size = UDim2.new(1,0,1,0) lbl.BackgroundTransparency = 1
                    lbl.TextScaled = true lbl.TextStrokeTransparency = 0
                    espCache[p] = lbl
                end
            end
            if espCache[p] then
                espCache[p].TextColor3 = col
                espCache[p].Text = "♡ " .. p.Name .. (isM and " [M]" or isS and " [S]" or " [I]")
            end
        end
    end
end
RS.RenderStepped:Connect(function() if Config.ESP then UpdateESP() end end)

