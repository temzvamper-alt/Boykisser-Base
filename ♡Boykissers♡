local Config = {
    AutoFarm = false, AutoFarmSpeed = 35,
    SilentAim = false, Aimbot = false,
    ESP = false, Fullbright = false,
    InfiniteJump = false, Noclip = false, Fly = false, FlySpeed = 50,
}

local function GetHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function GetMurderer()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            if plr.Character:FindFirstChild("Knife") or plr.Character:FindFirstChild("KillEffect") then
                return plr
            end
        end
    end
end

local function GetSheriff()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            if plr.Character:FindFirstChild("Gun") or plr.Character:FindFirstChild("Revolver") then
                return plr
            end
        end
    end
end

local function StartAutoFarm()
    task.spawn(function()
        while Config.AutoFarm do
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                local closest, dist = nil, math.huge
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj.Name == "Coin" or obj.Name == "Money" then
                        local part = obj:IsA("BasePart") and obj or obj:FindFirstChild("Handle")
                        if part then
                            local d = (part.Position - hrp.Position).Magnitude
                            if d < dist and d < 500 then dist, closest = d, part end
                        end
                    end
                end
                if closest then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then hum.WalkSpeed = Config.AutoFarmSpeed hum:MoveTo(closest.Position) end
                end
            end
            task.wait(0.3)
        end
    end)
end

task.spawn(function()
    while true do
        if Config.SilentAim or Config.Aimbot then
            local m = GetMurderer()
            if m and m.Character then
                local head = m.Character:FindFirstChild("Head") or m.Character:FindFirstChild("HumanoidRootPart")
                if head then Camera.CFrame = CFrame.new(Camera.CFrame.Position, head.Position) end
            end
        end
        task.wait(0.05)
    end
end)

local espCache = {}
local function UpdateESP()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local isM = char:FindFirstChild("Knife") or char:FindFirstChild("KillEffect")
            local isS = char:FindFirstChild("Gun") or char:FindFirstChild("Revolver")
            local color = isM and Color3.fromRGB(255, 105, 180) or isS and Color3.fromRGB(180, 105, 255) or Color3.fromRGB(255, 200, 230)
            if not espCache[p] then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local bb = Create("BillboardGui", {Size = UDim2.new(0, 200, 0, 50), AlwaysOnTop = true, StudsOffset = Vector3.new(0, 3, 0), Parent = hrp})
                    local lbl = Create("TextLabel", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, TextScaled = true, TextStrokeTransparency = 0, Parent = bb})
                    espCache[p] = lbl
                end
            end
            if espCache[p] then
                espCache[p].TextColor3 = color
                espCache[p].Text = "♡ " .. p.Name .. (isM and " [M]" or isS and " [S]" or " [I]")
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    if Config.ESP then UpdateESP() end
end)

