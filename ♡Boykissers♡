    Create("UIPadding", {
        PaddingTop = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 10),
        PaddingBottom = UDim.new(0, 10),
        Parent = scroll
    })
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    
    local tab = { Button = tabBtn, Content = scroll, Name = name }
    tabs[name] = tab
    
    tabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            Tween(t.Button, 0.15, {BackgroundColor3 = Theme.Tertiary, TextColor3 = Theme.SubText})
            t.Content.Visible = false
        end
        Tween(tabBtn, 0.15, {BackgroundColor3 = Theme.Accent, TextColor3 = Theme.Main})
        scroll.Visible = true
        currentTab = name
    end)
    
    if not currentTab then
        Tween(tabBtn, 0.15, {BackgroundColor3 = Theme.Accent, TextColor3 = Theme.Main})
        scroll.Visible = true
        currentTab = name
    end
    
    return tab
end

