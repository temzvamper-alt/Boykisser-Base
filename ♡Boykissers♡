local executorName = "Unknown"
local ok, name = pcall(function()
    return identifyexecutor and identifyexecutor() or (getexecutorname and getexecutorname()) or "Unknown"
end)
if ok and name then executorName = name end

-- Список поддерживаемых исполнителей
local supportedExecutors = {
    "Delta", "Xeno", "Arceus", "Solara", "Wave", "Real", "Neo"
}

local isSupported = false
for _, exec in ipairs(supportedExecutors) do
    if string.find(executorName:lower(), exec:lower()) then
        isSupported = true
        break
    end
end

-- Универсальная загрузка Rayfield (совместима со всеми исполнителями)
local Rayfield
local rayfieldOk, rayfieldResult = pcall(function()
    return loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
end)

if rayfieldOk and rayfieldResult then
    Rayfield = rayfieldResult
else
    -- Резервный метод через httpget
    local httpgetOk, httpgetResult = pcall(function()
        return loadstring(httpget('https://sirius.menu/rayfield'))()
    end)
    if httpgetOk and httpgetResult then
        Rayfield = httpgetResult
    else
        warn("♡ Boykisser Hub: Не удалось загрузить UI. Проверь интернет.")
        return
    end
end

