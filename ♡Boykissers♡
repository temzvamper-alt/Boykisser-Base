    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local hrp = char:FindFirstChild("HumanoidRootPart")
            
            if hrp then
                local isMurderer = char:FindFirstChild("Knife") or char:FindFirstChild("KillEffect")
                local isSheriff = char:FindFirstChild("Gun") or char:FindFirstChild("Revolver")
                
                local roleText = "Innocent"
                local roleColor = Color3.fromRGB(255, 200, 230)
                
                if isMurderer then
                    roleText = "Murderer"
                    roleColor = Color3.fromRGB(255, 60, 120)
                elseif isSheriff then
                    roleText = "Sheriff"
                    roleColor = Color3.fromRGB(120, 150, 255)
