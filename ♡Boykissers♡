CombatTab:CreateButton({
    Name = "🗡 Убить всех",
    Callback = function()
        local m = GetMurderer()
        if not m then
            Rayfield:Notify({Title = "Ошибка ♡", Content = "Убийца не найден ♡", Duration = 3})
            return
        end
        local char = game.Players.LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        for _, p in pairs(game.Players:GetPlayers()) do
            if p ~= game.Players.LocalPlayer and p.Character then
                local thp = p.Character:FindFirstChild("HumanoidRootPart")
                if thp then
                    hrp.CFrame = thp.CFrame * CFrame.new(0, 0, -2)
                    task.wait(0.05)
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then tool:Activate() end
                    task.wait(0.05)
                end
            end
        end
        Rayfield:Notify({Title = "♡ Kill All", Content = "Готово, кисс-кисс! ♡", Duration = 3})
    end,
})

